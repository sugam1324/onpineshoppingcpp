// ==================== FILE HANDLING ====================
void saveProducts(const vector<shared_ptr<Product>>& products)
{
    ofstream file("products.txt");

    if (!file)
    {
        cout << "Warning: Could not save products file.\n";
        return;
    }

    for (const auto& p : products)
    {
        file << p->getId() << ","
             << p->getName() << ","
             << p->getCategory() << ","
             << p->getPrice() << ","
             << p->getStock() << "\n";
    }

    file.close();
}

void saveOrder(const string& customer, const Cart& cart,
               double total, const string& paymentMethod)
{
    ofstream file("orders.txt", ios::app);

    if (!file)
    {
        throw runtime_error("Unable to save order. Checkout cancelled.");
    }

    file << "Customer: " << customer << "\n";
    file << "Payment: " << paymentMethod << "\n";

    for (const auto& item : cart.getItems())
    {
        file << item.product->getName()
             << " | Quantity: " << item.quantity
             << " | Subtotal: Rs. "
             << fixed << setprecision(2)
             << item.getSubtotal() << "\n";
    }

    file << "Total: Rs. " << fixed << setprecision(2)
         << total << "\n";
    file << "----------------------------------------\n";

    if (!file)
        throw runtime_error("Could not write the order to file.");
}

// ==================== ORDER CLASS ====================
class Order
{
private:
    static int orderCount;

public:
    static int getOrderCount()
    {
        return orderCount;
    }

    bool placeOrder(string customer, Cart& cart,
                    vector<shared_ptr<Product>>& products,
                    Payment& payment, string paymentMethod)
    {
        if (cart.isEmpty())
        {
            cout << "\nYour cart is empty. Add products first.\n";
            return false;
        }

        // Check stock again before checkout
        for (const auto& item : cart.getItems())
        {
            if (item.quantity > item.product->getStock())
            {
                cout << "\nInsufficient stock for "
                     << item.product->getName() << ".\n";
                return false;
            }
        }

        double total = cart.calculateTotal<double>();

        cout << "\n========== ORDER SUMMARY ==========\n";
        cout << "Customer: " << customer << "\n";
        cart.displayCart();

        cout << "\nConfirm your order? (1 = Yes, 0 = No): ";

        int confirm;

        if (!(cin >> confirm))
        {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input. Order cancelled.\n";
            return false;
        }

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        if (confirm != 1)
        {
            cout << "Order cancelled. Your cart is unchanged.\n";
            return false;
        }

        // Process payment before changing stock or clearing cart
        if (!payment.pay(total))
        {
            cout << "Payment failed. Your cart is unchanged.\n";
            return false;
        }

        // Save order details
        try
        {
            saveOrder(customer, cart, total, paymentMethod);
        }
        catch (const exception& e)
        {
            cout << e.what() << "\n";
            cout << "Please contact the shop administrator.\n";
        }

        // Update stock after successful simulated payment
        for (const auto& item : cart.getItems())
        {
            item.product->reduceStock(item.quantity);
        }

        saveProducts(products);

        orderCount++;

        cout << "\n====================================\n";
        cout << "ORDER PLACED SUCCESSFULLY!\n";
        cout << "Order number: " << orderCount << "\n";
        cout << "Total paid/payable: Rs. "
             << fixed << setprecision(2) << total << "\n";
        cout << "Thank you for shopping with us!\n";
        cout << "====================================\n";

        // Clear the cart ONLY after checkout
        cart.clear();

        return true;
    }
};

int Order::orderCount = 0;

