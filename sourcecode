// ==================== PRODUCT CLASS ====================
class Product
{
private:
    int id;
    string name;
    string category;
    double price;
    int stock;

    static int productCount;

public:
    Product(int i, string n, string c, double p, int s)
        : id(i), name(n), category(c), price(p), stock(s)
    {
        productCount++;
    }

    int getId() const { return id; }
    string getName() const { return name; }
    string getCategory() const { return category; }
    double getPrice() const { return price; }
    int getStock() const { return stock; }

    static int getProductCount()
    {
        return productCount;
    }

    void reduceStock(int quantity)
    {
        if (quantity <= 0 || quantity > stock)
            throw runtime_error("Invalid quantity or insufficient stock.");

        stock -= quantity;
    }

    friend ostream& operator<<(ostream& out, const Product& p)
    {
        out << left << setw(5) << p.id
            << setw(20) << p.name
            << setw(16) << p.category
            << "Rs. " << setw(10) << fixed << setprecision(2)
            << p.price
            << "Stock: " << p.stock;

        return out;
    }
};

int Product::productCount = 0;

// ==================== CART ITEM CLASS ====================
class CartItem
{
public:
    shared_ptr<Product> product;
    int quantity;

    CartItem(shared_ptr<Product> p, int q)
        : product(p), quantity(q)
    {
    }

    double getSubtotal() const
    {
        return product->getPrice() * quantity;
    }
};

// ==================== SHOPPING CART CLASS ====================
class Cart
{
private:
    vector<CartItem> items;

public:
    bool isEmpty() const
    {
        return items.empty();
    }

    // Add a product without losing existing cart items
    void addProduct(shared_ptr<Product> product, int quantity)
    {
        if (quantity <= 0)
            throw runtime_error("Quantity must be greater than zero.");

        auto it = find_if(items.begin(), items.end(),
            [&](const CartItem& item)
            {
                return item.product->getId() == product->getId();
            });

        int alreadyAdded = 0;

        if (it != items.end())
            alreadyAdded = it->quantity;

        if (alreadyAdded + quantity > product->getStock())
            throw runtime_error("Not enough stock available.");

        if (it != items.end())
        {
            it->quantity += quantity;
        }
        else
        {
            items.push_back(CartItem(product, quantity));
        }

        cout << "\nProduct added to cart successfully!\n";
    }

    // Remove a product from the cart
    void removeProduct(int productId)
    {

        [&](const CartItem& item)
            {
                return item.product->getId() == productId;
            });

        if (it == items.end())
        {
            cout << "\nProduct not found in your cart.\n";
            return;
        }

        items.erase(it);
        cout << "\nProduct removed from cart successfully.\n";
    }

    // Template function to calculate total
    template <typename T>
    T calculateTotal() const
    {
        T total = 0;

        for (const auto& item : items)
        {
            total += static_cast<T>(item.getSubtotal());
        }

        return total;
    }

    // Display cart: this function does NOT clear the cart
    void displayCart() const
    {
        if (items.empty())
        {
            cout << "\nYour cart is empty!\n";
            return;
        }

        cout << "\n================ YOUR SHOPPING CART ================\n";
        cout << left << setw(6) << "ID"
             << setw(20) << "Product"
             << setw(12) << "Price"
             << setw(10) << "Quantity"
             << "Subtotal\n";

        cout << string(65, '-') << "\n";

        for (const auto& item : items)
        {
            cout << left
                 << setw(6) << item.product->getId()
                 << setw(20) << item.product->getName()
                 << setw(12) << item.product->getPrice()
                 << setw(10) << item.quantity
                 << fixed << setprecision(2)
                 << item.getSubtotal() << "\n";
        }

        cout << string(65, '-') << "\n";
        cout << "TOTAL: Rs. "
             << fixed << setprecision(2)
             << calculateTotal<double>() << "\n";

        cout << "=====================================================\n";
    }

    const vector<CartItem>& getItems() const
    {
        return items;
    }

    void clear()
    {
        items.clear();
    }
};

