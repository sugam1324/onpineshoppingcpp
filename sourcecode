// ==================== SEARCH PRODUCT ====================
void searchProduct(const vector<shared_ptr<Product>>& products)
{
    cout << "\nEnter product name to search: ";

    string searchName;
    getline(cin, searchName);

    transform(searchName.begin(), searchName.end(),
              searchName.begin(),
              [](unsigned char ch)
              {
                  return static_cast<char>(tolower(ch));
              });

    bool found = false;

    for (const auto& p : products)
    {
        string name = p->getName();

        transform(name.begin(), name.end(), name.begin(),
                  [](unsigned char ch)
                  {
                      return static_cast<char>(tolower(ch));
                  });

        if (name.find(searchName) != string::npos)
        {
            cout << "\n" << *p << "\n";
            found = true;
        }
    }

    if (!found)
    {
        cout << "No matching product found.\n";
    }
}

// ==================== SAFE INTEGER INPUT ====================
int readInt(string message)
{
    while (true)
    {
        cout << message;

        string line;
        getline(cin, line);

        stringstream ss(line);
        int value;
        char extra;

        if (ss >> value && !(ss >> extra))
        {
            return value;
        }

        cout << "Invalid input. Please enter a whole number.\n";
    }
}

// ==================== PAUSE SCREEN ====================
void pressEnterToContinue()
{
    cout << "\nPress Enter to return to the menu...";
    string pause;
    getline(cin, pause);
}

// ==================== MAIN FUNCTION ====================
int main()
{
    try
    {
        cout << "========================================\n";
        cout << "       ONLINE SHOPPING SYSTEM\n";
        cout << "========================================\n";

        cout << "Enter your name: ";

        string customerName;
        getline(cin, customerName);

        if (customerName.empty())
            customerName = "Customer";

        // Create product catalogue
        vector<shared_ptr<Product>> products;

        products.push_back(make_shared<Product>(
            1, "Laptop", "Electronics", 55000, 10));

        products.push_back(make_shared<Product>(
            2, "Headphones", "Electronics", 2000, 20));

        products.push_back(make_shared<Product>(
            3, "T-Shirt", "Clothing", 800, 30));

        products.push_back(make_shared<Product>(
            4, "Shoes", "Footwear", 2500, 15));

        products.push_back(make_shared<Product>(
            5, "Smart Watch", "Electronics", 3500, 12));

        products.push_back(make_shared<Product>(
            6, "Keyboard", "Accessories", 1200, 25));

        Cart cart;
        Order order;

        int choice;

        // Menu repeats until the user chooses Exit
        do
        {
            cout << "\n\n========== MAIN MENU ==========\n";
            cout << "Welcome, " << customerName << "!\n";
            cout << "1. Display Products\n";
            cout << "2. Search Product\n";
            cout << "3. Add Product to Cart\n";
            cout << "4. Remove Product from Cart\n";
            cout << "5. View Shopping Cart\n";
            cout << "6. Checkout\n";
            cout << "7. View Shop Statistics\n";
            cout << "8. Exit\n";
            cout << "===============================\n";

            choice = readInt("Enter your choice: ");

            try
            {
                switch (choice)
                {
                    case 1:
                    {
                        displayProducts(products);
                        pressEnterToContinue();
                        break;
                    }

                    case 2:
                    {
                        searchProduct(products);
                        pressEnterToContinue();
                        break;
                    }

                    case 3:
                    {
                        displayProducts(products);

                        int id = readInt(
                            "\nEnter product ID to add: ");

                        int quantity = readInt(
                            "Enter quantity: ");

                        auto it = find_if(
                            products.begin(), products.end(),
                            [&](const shared_ptr<Product>& p)
                            {
                                return p->getId() == id;
                            });

                        if (it == products.end())
                        {
                            cout << "Invalid product ID.\n";
                        }
                        else
                        {
                            cart.addProduct(*it, quantity);
                        }

                        pressEnterToContinue();
                        break;
                    }

                    case 4:
                    {
                        // Show current cart before removing an item
                        cart.displayCart();

                        if (!cart.isEmpty())
                        {
                            int id = readInt(
                                "\nEnter product ID to remove: ");

                            cart.removeProduct(id);
                        }

                        pressEnterToContinue();
                        break;
                    }

                    case 5:
                    {
                        // IMPORTANT: Displaying the cart never clears it
                        cart.displayCart();

                        pressEnterToContinue();
                        break;
                    }

                    case 6:
                    {
                        cout << "\nSelect payment method:\n";
                        cout << "1. Card\n";
                        cout << "2. UPI\n";
                        cout << "3. Cash on Delivery\n";

                        int paymentChoice = readInt(
                            "Enter payment choice: ");

                        if (paymentChoice == 1)
                        {
                            CardPayment payment;

                            order.placeOrder(
                                customerName, cart, products,
                                payment, "Card");
                        }
                        else if (paymentChoice == 2)
                        {
                            UPIPayment payment;

                            order.placeOrder(
                                customerName, cart, products,
                                payment, "UPI");
                        }
                        else if (paymentChoice == 3)
                        {
                            CODPayment payment;

                            order.placeOrder(
                                customerName, cart, products,
                                payment, "Cash on Delivery");
                        }
                        else
                        {
                            cout << "Invalid payment choice.\n";
                        }

                        pressEnterToContinue();
                        break;
                    }

                    case 7:
                    {
                        cout << "\n========== SHOP STATISTICS ==========\n";
                        cout << "Number of products: "
                             << Product::getProductCount() << "\n";
                        cout << "Orders completed this session: "
                             << Order::getOrderCount() << "\n";
                        cout << "Products currently in your cart: "
                             << cart.getItems().size() << "\n";
                        cout << "=====================================\n";

                        pressEnterToContinue();
                        break;
                    }

                    case 8:
                    {
                        cout << "\nThank you for visiting our shop, "
                             << customerName << "!\n";
                        cout << "Goodbye!\n";
                        break;
                    }

                    default:
                    {
                        cout << "Invalid choice. Enter a number from 1 to 8.\n";
                        pressEnterToContinue();
                    }
                }
            }
            catch (const exception& e)
            {
                cout << "\nError: " << e.what() << "\n";
                pressEnterToContinue();
            }

        } while (choice != 8);
    }
    catch (const exception& e)
    {
        cout << "\nProgram error: " << e.what() << "\n";
    }

    return 0;
}
